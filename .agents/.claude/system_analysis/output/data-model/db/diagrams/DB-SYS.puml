}
entity policy_consents {
  * id : bigint <<PK>>
  --
  * agreed_at : timestamptz
  * user_id : bigint <<FK>>
  * policy_version_id : bigint <<FK>>
}
entity policy_versions {
  * id : bigint <<PK>>
  --
  * version : text
  * content : text
  * released_at : timestamptz
}
entity polls {
  * id : bigint <<PK>>
  --
  * allow_multiple : boolean
  * show_result_before_vote : boolean
  * expires_at : timestamptz
  * is_closed : boolean
  * post_id : bigint <<FK>>
}
entity poll_options {
  * id : bigint <<PK>>
  --
  * label : text
  * poll_id : bigint <<FK>>
}
entity poll_selections {
  * id : bigint <<PK>>
  --
  * poll_option_id : bigint <<FK>>
  * voter_id : bigint <<FK>>
}
entity posts {
  * id : bigint <<PK>>
  --
  title : varchar(150)
  content : text
  grade_level : varchar(30)
  * created_at : timestamptz
  * updated_at : timestamptz
  * publish_state : varchar(30)
  * mod_state : varchar(30)
  * lock_level : varchar(30)
  locked_by : varchar(30)
  published_at : timestamptz
  rejection_reason : text
  violation_category : varchar(30)
