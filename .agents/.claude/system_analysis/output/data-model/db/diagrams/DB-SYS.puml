@startuml
hide circle
skinparam linetype ortho

entity admin_logs {
  * id : bigint <<PK>>
  --
  * action_type : varchar(30)
  reason : text
  * created_at : timestamptz
  * is_by_system : boolean
  actor_id : bigint <<FK>>
  target_user_id : bigint <<FK>>
  config_switch_id : bigint <<FK>>
  banner_id : bigint <<FK>>
  post_id : bigint <<FK>>
  comment_id : bigint <<FK>>
  group_id : bigint <<FK>>
  report_case_id : bigint <<FK>>
  appeal_id : bigint <<FK>>
  topic_id : bigint <<FK>>
  tag_id : bigint <<FK>>
}
entity ai_decision_logs {
  * id : bigint <<PK>>
  --
  * call_type : varchar(30)
  * is_success : boolean
  raw_output : text
  * created_at : timestamptz
  score_band : varchar(30)
  post_id : bigint <<FK>>
  comment_id : bigint <<FK>>
}
entity appeals {
  * id : bigint <<PK>>
  --
  * type : varchar(30)
  * explanation : text
  * submitted_at : timestamptz
  * status : varchar(30)
  last_holder_action_at : timestamptz
  conclusion : varchar(30)
