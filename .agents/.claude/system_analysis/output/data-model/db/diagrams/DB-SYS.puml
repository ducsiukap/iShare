}
entity mentions {
  * id : bigint <<PK>>
  --
  notified_at : timestamptz
  * mentioned_user_id : bigint <<FK>>
  post_id : bigint <<FK>>
  comment_id : bigint <<FK>>
}
entity messages {
  * id : bigint <<PK>>
  --
  * content : text
  * sent_at : timestamptz
  * is_recalled : boolean
  * conversation_id : bigint <<FK>>
  * sender_id : bigint <<FK>>
}
entity moderation_logs {
  * id : bigint <<PK>>
  --
  * action_type : varchar(30)
  * reason : text
  * created_at : timestamptz
  * is_by_ai : boolean
  actor_id : bigint <<FK>>
  target_user_id : bigint <<FK>>
  post_id : bigint <<FK>>
  comment_id : bigint <<FK>>
  group_id : bigint <<FK>>
  tag_id : bigint <<FK>>
  report_case_id : bigint <<FK>>
}
entity muted_conversations {
  * id : bigint <<PK>>
  --
  * user_id : bigint <<FK>>
  * conversation_id : bigint <<FK>>
}
entity muted_posts {
  * id : bigint <<PK>>
  --
  * user_id : bigint <<FK>>
  * post_id : bigint <<FK>>
}
entity notifications {
  * id : bigint <<PK>>
