}
entity post_tags {
  * id : bigint <<PK>>
  --
  * tag_id : bigint <<FK>>
  * post_id : bigint <<FK>>
}
entity post_topics {
  * id : bigint <<PK>>
  --
  * topic_id : bigint <<FK>>
  * post_id : bigint <<FK>>
}
entity post_trending_stats {
  * post_id : bigint <<PK>> <<FK>>
