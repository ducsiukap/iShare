  * type : varchar(30)
  name : varchar(100)
  is_approval_on : boolean
  invite_link : text
}
entity conversation_members {
  * id : bigint <<PK>>
  --
  role : varchar(30)
  * status : varchar(30)
  left_at : timestamptz
