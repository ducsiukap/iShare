}
entity follows {
  * id : bigint <<PK>>
  --
  * followed_at : timestamptz
  * follower_id : bigint <<FK>>
  followed_user_id : bigint <<FK>>
  topic_id : bigint <<FK>>
}
entity groups {
  * id : bigint <<PK>>
  --
  * name : varchar(100)
  description : varchar(500)
  * privacy : varchar(30)
  join_question : text
  * is_pre_approval_on : boolean
  * is_anonymous_on : boolean
  * created_at : timestamptz
  * is_deleted : boolean
  * mod_state : varchar(30)
  * invite_link : text
  * creator_id : bigint <<FK>>
}
entity group_join_blocks {
  * id : bigint <<PK>>
  --
  * blocked_user_id : bigint <<FK>>
  * group_id : bigint <<FK>>
}
entity group_join_requests {
  * id : bigint <<PK>>
  --
  answer : text
  * status : varchar(30)
  * requester_id : bigint <<FK>>
  * group_id : bigint <<FK>>
}
entity group_members {
  * id : bigint <<PK>>
  --
  * role : varchar(30)
  * joined_at : timestamptz
  mod_appointed_at : timestamptz
