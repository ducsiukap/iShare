  * name : text
  * threshold : integer
}
entity bans {
  * id : bigint <<PK>>
  --
  * kind : varchar(30)
  duration : integer
  * started_at : timestamptz
  * reason : text
  * status : varchar(30)
  * report_case_id : bigint <<FK>>
  * banned_user_id : bigint <<FK>>
  * banned_by_id : bigint <<FK>>
}
entity banners {
  * id : bigint <<PK>>
  --
  * content : varchar(200)
  * status : varchar(30)
}
entity banner_dismissals {
  * id : bigint <<PK>>
