  * banner_id : bigint <<FK>>
  * user_id : bigint <<FK>>
}
entity bookmarks {
  * id : bigint <<PK>>
  --
  * saved_at : timestamptz
  * user_id : bigint <<FK>>
  * post_id : bigint <<FK>>
}
entity chat_join_requests {
  * id : bigint <<PK>>
  --
  * status : varchar(30)
  * created_at : timestamptz
  * conversation_id : bigint <<FK>>
  * requester_id : bigint <<FK>>
}
entity chat_member_proposals {
  * id : bigint <<PK>>
  --
  * status : varchar(30)
  * created_at : timestamptz
  * conversation_id : bigint <<FK>>
  * proposed_user_id : bigint <<FK>>
  * proposer_id : bigint <<FK>>
}
entity chosen_topics {
  * id : bigint <<PK>>
  --
  * topic_suggestion_feedback_id : bigint <<FK>>
  * topic_id : bigint <<FK>>
}
