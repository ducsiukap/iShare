  * score : integer
  * new_post_count : integer
  * computed_at : timestamptz
}
entity upvotes {
  * id : bigint <<PK>>
  --
  * upvoted_at : timestamptz
  upvoter_id : bigint <<FK>>
  post_id : bigint <<FK>>
  comment_id : bigint <<FK>>
}
entity users {
  * id : bigint <<PK>>
  --
  email : text
  password : text
  username : varchar(20)
  display_name : varchar(50)
  * role : varchar(30)
  * status : varchar(30)
  * verification_level : varchar(30)
  google_link : varchar(255)
  deactivated_at : timestamptz
  * created_at : timestamptz
