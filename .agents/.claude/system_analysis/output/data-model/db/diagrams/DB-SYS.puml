  * group_id : bigint <<FK>>
}
entity leaderboards {
  * id : bigint <<PK>>
  --
  * period : varchar(30)
  period_start : timestamptz
  * computed_at : timestamptz
}
entity leaderboard_entries {
  * id : bigint <<PK>>
  --
  * period_points : integer
  * rank : integer
  grade_level : varchar(30)
  * leaderboard_id : bigint <<FK>>
  * user_id : bigint <<FK>>
}
entity login_sessions {
  * id : bigint <<PK>>
  --
  * device : text
  * access_expires_at : timestamptz
  * refresh_token : text
  * refresh_expires_at : timestamptz
  * user_id : bigint <<FK>>
}
entity magic_links {
  * id : bigint <<PK>>
  --
  * purpose : varchar(30)
  * token : text
  * sent_at : timestamptz
  * is_used : boolean
