@startuml
hide circle
hide methods
skinparam classAttributeIconSize 0

class Proposal {
  -id : long
  -type : ProposalType
  -sentAt : Instant
  -status : ProposalStatus
  -sender : User
  -nominee : User
}
class ConfigSwitch {
  -id : long
  -name : ConfigSwitchName
  -status : SwitchStatus
}
class Banner {
  -id : long
  -content : String
  -status : BannerStatus
  -dismissals : List<BannerDismissal>
}
class BannerDismissal {
  -id : long
  -user : User
}
class AdminLog {
  -id : long
  -actionType : AdminActionType
  -reason : String
  -createdAt : Instant
  -isBySystem : boolean
  -actor : User
  -targetUser : User
  -configSwitch : ConfigSwitch
  -banner : Banner
  -post : Post
  -comment : Comment
  -group : Group
  -reportCase : ReportCase
  -appeal : Appeal
  -topic : Topic
  -tag : Tag
}
class User <<M01>> {
}
class Post <<M03>> {
}
class Comment <<M04>> {
}
class Group <<M11>> {
}
class ReportCase <<M08>> {
}
class Appeal <<M09>> {
}
class Topic <<M05>> {
}
class Tag <<M05>> {
}
enum ProposalType {
  MOD
  ADMIN
}
enum ProposalStatus {
  PENDING
  ACCEPTED
  DECLINED
  EXPIRED
}
enum ConfigSwitchName {
  AI_ENABLED
  AI_SEARCH
  AI_MODERATION
  AI_TOPIC_SUGGESTION
  MAINTENANCE_MODE
  REGISTRATION_PAUSED
  GROUP_ENABLED
  CHAT_ENABLED
  GAMIFICATION_ENABLED
}
enum SwitchStatus {
  ON
  OFF
}
enum BannerStatus {
  SHOWN
  HIDDEN
}
enum AdminActionType {
  PROPOSE_MOD
  PROPOSE_ADMIN
  ACCEPT_PROPOSAL
  DEMOTE_MOD
  REVOKE_ADMIN
  RESIGN
  REVOKE_MOD_ON_BAN
  CHANGE_SWITCH
  SET_BANNER
  EDIT_BANNER
  REMOVE_BANNER
  WARN
  REMOVE_AI_WARNING
  BAN
  UNBAN
  HIDE_CONTENT
  HIDE_GROUP
  LOCK_GROUP
  UNLOCK_GROUP
  CONCLUDE_CASE
  CONCLUDE_APPEAL
  ADD_TOPIC
  MERGE_TOPIC
  DELETE_TOPIC
  DISABLE_TAG
  ENABLE_TAG
  CHANGE_POST_TOPIC_TAG
}

Proposal "0..*" o-- "1" User
Proposal "0..*" o-- "1" User
AdminLog "0..*" o-- "0..1" User
AdminLog "0..*" o-- "0..1" User
AdminLog "0..*" o-- "0..1" ConfigSwitch
AdminLog "0..*" o-- "0..1" Banner
AdminLog "0..*" o-- "0..1" Post
AdminLog "0..*" o-- "0..1" Comment
AdminLog "0..*" o-- "0..1" Group
AdminLog "0..*" o-- "0..1" ReportCase
AdminLog "0..*" o-- "0..1" Appeal
AdminLog "0..*" o-- "0..1" Topic
AdminLog "0..*" o-- "0..1" Tag
Banner "1" o-- "0..*" BannerDismissal
BannerDismissal "0..*" o-- "1" User

@enduml
