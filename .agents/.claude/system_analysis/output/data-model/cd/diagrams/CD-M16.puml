@startuml
hide circle
hide methods
skinparam classAttributeIconSize 0

class Conversation {
  -id : long
  -type : ConversationType
  -name : String
  -isApprovalOn : boolean
  -inviteLink : String
  -members : List<ConversationMember>
  -messages : List<Message>
  -memberProposals : List<ChatMemberProposal>
  -chatJoinRequests : List<ChatJoinRequest>
}
class ConversationMember {
  -id : long
  -role : ChatRole
  -status : ConversationMemberStatus
  -leftAt : Instant
  -user : User
  -lastReadMessage : Message
}
class Message {
  -id : long
  -content : String
  -sentAt : Instant
  -isRecalled : boolean
  -sender : User
}
class ChatMemberProposal {
  -id : long
  -status : ChatRequestStatus
  -createdAt : Instant
  -proposedUser : User
  -proposer : User
}
class ChatJoinRequest {
  -id : long
  -status : ChatRequestStatus
  -createdAt : Instant
  -requester : User
}
class User <<M01>> {
}
class Profile <<M02>> {
}
enum ConversationType {
  DIRECT
  GROUP
}
enum ChatRole {
  ADMIN
  MEMBER
}
enum ConversationMemberStatus {
  ACTIVE
  LEFT
  REMOVED
}
enum ChatRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

ConversationMember "0..*" o-- "1" User
Conversation "1" o-- "1..*" ConversationMember
Conversation "1" o-- "0..*" Message
Message "0..*" o-- "1" User
ConversationMember "0..*" o-- "0..1" Message
Conversation "1" o-- "0..*" ChatMemberProposal
ChatMemberProposal "0..*" o-- "1" User
ChatMemberProposal "0..*" o-- "1" User
Conversation "1" o-- "0..*" ChatJoinRequest
ChatJoinRequest "0..*" o-- "1" User

@enduml
