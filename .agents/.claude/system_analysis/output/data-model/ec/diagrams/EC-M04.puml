@startuml
hide circle
hide methods
skinparam classAttributeIconSize 0

class Comment {
  -content
  -publishedAt
  -editedAt
  -modState
  -deletedAt
  -/isDeleted
  -/isEdited
  -/isVisible
  -/upvoteCount
  -scannedAt
  -/isScannedCurrent
  -/replyRate
  -isRemovedFromGroup
  -isPointsDeducted
}
class Post <<M03>> {
  -title
  -content
  -/contentText
  -gradeLevel
  -createdAt
  -updatedAt
  -publishState
  -modState
  -lockLevel
  -lockedBy
  -publishedAt
  -rejectionReason
  -violationCategory
  -isInReviewQueue
  -isEditedWhileHidden
  -deletedAt
  -publishStateBeforeDelete
  -isPermanentlyDeleted
  -/isPubliclyVisible
  -/isEdited
  -/commentCount
  -rejectedAt
  -isAnonymous
  -scanScore
  -isAwaitingGroupReview
  -lastHolderActionAt
  -isRemovedFromGroup
  -isPointsDeducted
  -deductedPoints
  -/upvoteCount
  -embedding
  -needsEmbedding
  -/bookmarkCount
}
class User <<M01>> {
  -email
  -password
  -username
  -displayName
  -role
  -status
  -verificationLevel
  -googleLink
  -deactivatedAt
  -/deactivationEndsAt
  -/isGoogleAccount
  -createdAt
  -/unreadNotificationCount
  -/banCount
  -isRoot
  -totalPoints
}
class Upvote <<M12>> {
  -upvotedAt
}

Post "1" o-- "0..*" Comment
Comment "0..*" o-- "1" User
Comment "0..1" o-- "0..*" Comment
Comment "0..*" o-- "0..1" Comment
Comment "0..1" o-- "0..*" Upvote

@enduml
