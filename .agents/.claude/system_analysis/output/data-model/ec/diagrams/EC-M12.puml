@startuml
hide circle
hide methods
skinparam classAttributeIconSize 0

class Upvote {
  -upvotedAt
}
class Badge {
  -name
  -threshold
}
class EarnedBadge {
  -achievedAt
}
class EarnedTitle {
  -week
}
class Leaderboard {
  -period
  -periodStart
  -computedAt
}
class LeaderboardEntry {
  -periodPoints
  -rank
  -gradeLevel
  -/isWeeklyStar
}
class User <<M01>> {
  -totalPoints
  -role
  -status
  -username
  -displayName
}
class Post <<M03>> {
  -lockLevel
  -/isPubliclyVisible
  -modState
  -isPermanentlyDeleted
  -isPointsDeducted
  -deductedPoints
  -/upvoteCount
}
class Comment <<M04>> {
  -modState
  -/isDeleted
  -/isVisible
  -isPointsDeducted
}
class Profile <<M02>> {
  -gradeLevel
  -avatar
}
class UserWarningStatus <<M08>> {
  -/level
}

(User, Badge) .. EarnedBadge
(User, Leaderboard) .. LeaderboardEntry
Upvote "0..*" o-- "0..1" User
Post "0..1" o-- "0..*" Upvote
Comment "0..1" o-- "0..*" Upvote
EarnedTitle "0..*" o-- "1" User

@enduml
