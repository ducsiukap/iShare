@startuml
hide circle
hide methods
skinparam classAttributeIconSize 0

class Report {
  -reason
  -description
  -isAiCreated
  -scanScore
  -/status
  -/conclusion
  -/concentrationIndex
  -reportedAt
}
class ReportEvidence {
  -image
}
class ReportCase {
  -targetType
  -status
  -openedAt
  -/reportCount
  -/priorityScore
  -isBanRequest
  -lastHolderActionAt
  -conclusion
  -conclusionReason
  -concludedAt
}
class Warning {
  -reason
  -issuedAt
  -isIssuedByAi
  -status
  -levelAfter
}
class UserWarningStatus {
  -warningCount
  -/level
  -probationEndsAt
}
class Ban {
  -kind
  -duration
  -startedAt
  -/endsAt
  -reason
  -status
  -/appealDeadline
}
class ModerationLog {
  -actionType
  -reason
  -createdAt
  -isByAi
}
class User <<M01>> {
  -email
  -password
  -username
  -displayName
  -role
  -status
  -verificationLevel
  -googleLink
  -deactivatedAt
  -/deactivationEndsAt
  -/isGoogleAccount
  -createdAt
  -/unreadNotificationCount
  -/banCount
  -isRoot
  -totalPoints
}
class Post <<M03>> {
  -title
  -content
  -/contentText
  -gradeLevel
  -createdAt
  -updatedAt
  -publishState
  -modState
  -lockLevel
  -lockedBy
  -publishedAt
  -rejectionReason
  -violationCategory
  -isInReviewQueue
  -isEditedWhileHidden
  -deletedAt
  -publishStateBeforeDelete
  -isPermanentlyDeleted
  -/isPubliclyVisible
  -/isEdited
  -/commentCount
  -rejectedAt
  -isAnonymous
  -scanScore
  -isAwaitingGroupReview
  -lastHolderActionAt
  -isRemovedFromGroup
  -isPointsDeducted
  -deductedPoints
  -/upvoteCount
  -embedding
  -needsEmbedding
  -/bookmarkCount
}
class Comment <<M04>> {
  -content
  -publishedAt
  -editedAt
  -modState
  -deletedAt
  -/isDeleted
  -/isEdited
  -/isVisible
  -/upvoteCount
  -scannedAt
  -/isScannedCurrent
  -/replyRate
  -isRemovedFromGroup
  -isPointsDeducted
}
class Group <<M11>> {
  -name
  -description
  -privacy
  -joinQuestion
  -isPreApprovalOn
  -isAnonymousOn
  -createdAt
  -isDeleted
  -modState
  -inviteLink
  -/isInstantJoin
}
class Tag <<M05>> {
  -name
  -status
  -createdAt
}

ReportCase "1" o-- "1..*" Report
Report "1" o-- "0..3" ReportEvidence
Report "0..*" o-- "0..1" User
ReportCase "0..*" o-- "0..1" Post
ReportCase "0..*" o-- "0..1" Comment
ReportCase "0..*" o-- "0..1" User
ReportCase "0..*" o-- "0..1" Group
ReportCase "0..*" o-- "0..1" User
ReportCase "0..*" o-- "0..1" User
Warning "0..*" o-- "0..1" ReportCase
ReportCase "1" -- "0..*" Ban
Warning "0..*" o-- "1" User
Warning "0..*" o-- "0..1" User
Warning "0..*" o-- "0..1" Post
Warning "0..*" o-- "0..1" Comment
UserWarningStatus "1" o-- "1" User
Ban "0..*" o-- "1" User
Ban "0..*" o-- "1" User
ModerationLog "0..*" o-- "0..1" User
ModerationLog "0..*" o-- "0..1" User
ModerationLog "0..*" o-- "0..1" Post
ModerationLog "0..*" o-- "0..1" Comment
ModerationLog "0..*" o-- "0..1" Group
ModerationLog "0..*" o-- "0..1" Tag
ModerationLog "0..*" o-- "0..1" ReportCase

@enduml
