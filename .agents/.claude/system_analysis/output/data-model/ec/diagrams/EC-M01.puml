@startuml
hide circle
hide methods
skinparam classAttributeIconSize 0

class User {
  -email
  -password
  -username
  -displayName
  -role
  -status
  -verificationLevel
  -googleLink
  -deactivatedAt
  -/deactivationEndsAt
  -/isGoogleAccount
  -createdAt
  -/unreadNotificationCount
  -/banCount
  -isRoot
  -totalPoints
}
class MagicLink {
  -purpose
  -token
  -sentAt
  -/expiresAt
  -isUsed
}
class ReactivationCode {
  -code
  -sentAt
  -/expiresAt
  -failedAttemptCount
}
class LoginSession {
  -device
  -accessExpiresAt
  -refreshToken
  -refreshExpiresAt
}
class Mention {
  -notifiedAt
}
class PolicyVersion {
  -version
  -content
  -releasedAt
  -/isCurrent
}
class PolicyConsent {
  -agreedAt
}
class Profile <<M02>> {
  -avatar
  -bio
  -gradeLevel
  -/followerCount
  -/followingCount
}
class Bookmark <<M02>> {
  -savedAt
}
class Post <<M03>> {
  -title
  -content
  -/contentText
  -gradeLevel
  -createdAt
  -updatedAt
  -publishState
  -modState
  -lockLevel
  -lockedBy
  -publishedAt
  -rejectionReason
  -violationCategory
  -isInReviewQueue
  -isEditedWhileHidden
  -deletedAt
  -publishStateBeforeDelete
  -isPermanentlyDeleted
  -/isPubliclyVisible
  -/isEdited
  -/commentCount
  -rejectedAt
  -isAnonymous
  -scanScore
  -isAwaitingGroupReview
  -lastHolderActionAt
  -isRemovedFromGroup
  -isPointsDeducted
  -deductedPoints
  -/upvoteCount
  -embedding
  -needsEmbedding
  -/bookmarkCount
}
class Comment <<M04>> {
  -content
  -publishedAt
  -editedAt
  -modState
  -deletedAt
  -/isDeleted
  -/isEdited
  -/isVisible
  -/upvoteCount
  -scannedAt
  -/isScannedCurrent
  -/replyRate
  -isRemovedFromGroup
  -isPointsDeducted
}
class Follow <<M07>> {
  -followedAt
}
class Ban <<M08>> {
  -kind
  -duration
  -startedAt
  -/endsAt
  -reason
  -status
  -/appealDeadline
}
class Upvote <<M12>> {
  -upvotedAt
}

(User, PolicyVersion) .. PolicyConsent
User "1" o-- "0..*" MagicLink
User "1" o-- "0..*" ReactivationCode
User "1" o-- "0..*" LoginSession
Mention "0..*" o-- "1" User
Post "0..1" o-- "0..*" Mention
Comment "0..1" o-- "0..*" Mention
User "1" o-- "1" Profile
User "1" -- "0..*" Bookmark
Post "0..*" o-- "1" User
Comment "0..*" o-- "1" User
Follow "0..*" o-- "1" User
Follow "0..*" o-- "0..1" User
Ban "0..*" o-- "1" User
Upvote "0..*" o-- "0..1" User

@enduml
