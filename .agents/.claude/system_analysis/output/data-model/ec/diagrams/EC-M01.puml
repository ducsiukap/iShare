@startuml
hide circle
hide methods
skinparam classAttributeIconSize 0

class User {
  -email
  -password
  -username
  -displayName
  -role
  -status
  -verificationLevel
  -googleLink
  -deactivatedAt
  -/deactivationEndsAt
  -/isGoogleAccount
  -createdAt
}
class MagicLink {
  -purpose
  -token
  -sentAt
  -/expiresAt
  -isUsed
}
class ReactivationCode {
  -code
  -sentAt
  -/expiresAt
  -failedAttemptCount
}
class LoginSession {
  -device
  -accessExpiresAt
  -refreshToken
  -refreshExpiresAt
}
class Mention {
  -notifiedAt
}
class PolicyVersion {
  -version
  -content
  -releasedAt
  -/isCurrent
}
class PolicyConsent {
  -agreedAt
}
class Profile <<M02>> {
  -bio
  -gradeLevel
  -avatar
}
class Bookmark <<M02>> {
}
class Post <<M03>> {
}
class Comment <<M04>> {
}
class Follow <<M07>> {
}
class Ban <<M08>> {
  -reason
  -endsAt
  -/appealDeadline
}
class Upvote <<M12>> {
}

(User, PolicyVersion) .. PolicyConsent
User "1" o-- "0..*" MagicLink
User "1" o-- "0..*" ReactivationCode
User "1" o-- "0..*" LoginSession
Mention "0..*" o-- "1" User
Post "0..1" o-- "0..*" Mention
Comment "0..1" o-- "0..*" Mention
User "1" o-- "1" Profile
Bookmark "0..*" o-- "1" User
Post "0..*" o-- "1" User
Comment "0..*" o-- "1" User
Follow "0..*" o-- "1" User
Follow "0..*" o-- "0..1" User
Ban "0..*" o-- "1" User
Upvote "0..*" o-- "0..1" User

@enduml
