@startuml
hide circle
hide methods
skinparam classAttributeIconSize 0

class AiDecisionLog {
  -callType
  -isSuccess
  -rawOutput
  -createdAt
  -/scanScore
  -/violationCategory
  -/scoreBand
}
class PostSummary {
  -content
  -createdAt
}
class TopicSuggestionStat <<stat>> {
  -period
  -/suggestedCount
  -/keptCount
  -/retentionRate
}
class Post <<M03>> {
  -title
  -content
  -/contentText
  -gradeLevel
  -createdAt
  -updatedAt
  -publishState
  -modState
  -lockLevel
  -lockedBy
  -publishedAt
  -rejectionReason
  -violationCategory
  -isInReviewQueue
  -isEditedWhileHidden
  -deletedAt
  -publishStateBeforeDelete
  -isPermanentlyDeleted
  -/isPubliclyVisible
  -/isEdited
  -/commentCount
  -rejectedAt
  -isAnonymous
  -scanScore
  -isAwaitingGroupReview
  -lastHolderActionAt
  -isRemovedFromGroup
  -isPointsDeducted
  -deductedPoints
  -/upvoteCount
  -embedding
  -needsEmbedding
  -/bookmarkCount
}
class Comment <<M04>> {
  -content
  -publishedAt
  -editedAt
  -modState
  -deletedAt
  -/isDeleted
  -/isEdited
  -/isVisible
  -/upvoteCount
  -scannedAt
  -/isScannedCurrent
  -/replyRate
  -isRemovedFromGroup
  -isPointsDeducted
}
class TopicSuggestionFeedback <<M05>> {
  -recordedAt
}

AiDecisionLog "0..*" o-- "0..1" Post
AiDecisionLog "0..*" o-- "0..1" Comment
Post "1" o-- "0..1" PostSummary
TopicSuggestionStat ..> TopicSuggestionFeedback

@enduml
