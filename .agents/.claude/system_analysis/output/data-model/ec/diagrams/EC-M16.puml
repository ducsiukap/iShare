@startuml
hide circle
hide methods
skinparam classAttributeIconSize 0

class Conversation {
  -type
  -name
  -isApprovalOn
  -inviteLink
}
class ConversationMember {
  -role
  -status
  -leftAt
}
class Message {
  -content
  -sentAt
  -isRecalled
}
class ChatMemberProposal {
  -status
  -createdAt
}
class ChatJoinRequest {
  -status
  -createdAt
}
class User <<M01>> {
  -email
  -password
  -username
  -displayName
  -role
  -status
  -verificationLevel
  -googleLink
  -deactivatedAt
  -/deactivationEndsAt
  -/isGoogleAccount
  -createdAt
  -/unreadNotificationCount
  -/banCount
  -isRoot
  -totalPoints
}
class Profile <<M02>> {
  -avatar
  -bio
  -gradeLevel
  -/followerCount
  -/followingCount
}

(User, Conversation) .. ConversationMember
Conversation "1" o-- "0..*" Message
Message "0..*" o-- "1" User
ConversationMember "0..*" o-- "0..1" Message
Conversation "1" o-- "0..*" ChatMemberProposal
ChatMemberProposal "0..*" o-- "1" User
ChatMemberProposal "0..*" o-- "1" User
Conversation "1" o-- "0..*" ChatJoinRequest
ChatJoinRequest "0..*" o-- "1" User

@enduml
