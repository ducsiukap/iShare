  "spacing": {
    "space-0-5": {
      "$type": "dimension",
      "$value": "2px",
      "$description": "Khe rất nhỏ: khoảng cách vòng focus, đệm dọc của code trong dòng."
    },
    "space-1": {
      "$type": "dimension",
      "$value": "4px",
      "$description": "Giữa icon nhỏ và số đếm; đệm dọc nhãn, chip."
    },
    "space-2": {
      "$type": "dimension",
      "$value": "8px",
      "$description": "Giữa icon và chữ trong nút; đệm dọc dòng bảng mức gọn; khoảng cách các nút trong một nhóm."
    },
    "space-3": {
      "$type": "dimension",
      "$value": "12px",
      "$description": "Đệm ngang chip, mục menu; khoảng cách giữa các ô trong form gọn."
    },
    "space-4": {
      "$type": "dimension",
      "$value": "16px",
      "$description": "Đệm ngang nút, ô nhập; đệm khối nhỏ; khoảng cách giữa các ô trong form."
    },
    "space-5": {
      "$type": "dimension",
      "$value": "20px",
      "$description": "Đệm thẻ bài trong danh sách, dialog, ngăn trượt."
    },
    "space-6": {
      "$type": "dimension",
      "$value": "24px",
      "$description": "Khoảng cách giữa các nhóm nội dung; đệm khối lớn."
    },
    "space-8": {
      "$type": "dimension",
      "$value": "32px",
      "$description": "Đệm ngang vùng nội dung trang; khoảng cách giữa các cột."
    },
    "space-10": {
      "$type": "dimension",
      "$value": "40px",
      "$description": "Khoảng cách giữa các mục lớn của trang."
    },
    "space-12": {
      "$type": "dimension",
      "$value": "48px",
      "$description": "Đệm trên dưới của trang trạng thái (lỗi, trống, bảo trì)."
    },
    "space-16": {
      "$type": "dimension",
      "$value": "64px",
      "$description": "Lề trên của trang trạng thái toàn màn hình."
    }
